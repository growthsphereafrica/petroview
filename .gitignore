# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Environment files. The .example templates stay tracked so the required
# variables are documented; the real files must never be committed, or the next
# person to add a secret to .env leaks it silently.
.env
.env.*
!.env.example
!.env.*.example

# Local SQLite ledgers and generated databases
backend/data/
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.db

