# PetroView Backend Environment Configuration
NODE_ENV=production
PORT=4000
DB_PATH=/app/data/masterview.sqlite

# Security & Master Admin
# REQUIRED. The Super Admin account can reach every tenant, so there is no
# default value — the server refuses to boot without it, and refuses to boot if
# it is set to a PIN that has been published in this project's docs or history.
# Choose a value that has never appeared anywhere in this repository.
SUPER_ADMIN_PIN=

# Seeding & Safety controls (Never enable in production)
SEED_DEMO_DATA=false
ENABLE_DESTRUCTIVE_OPERATIONS=false

# Allowed Web Origins (comma-separated). Mobile clients bypass CORS as native apps.
# Leave empty in production to reject every browser origin.
CORS_ORIGINS=https://petroview.growthspheregh.com

# Absolute tolerance, in GHS, between a device's synced unit price and the
# company price list. Default 0.01 (exact match).
# Widen this only for the duration of a price-change rollout, and never by more
# than the size of the price change itself.
PRICE_TOLERANCE_GHS=0.01
